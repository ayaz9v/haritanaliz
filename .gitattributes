# Normalize line endings: LF in the repository and in working trees on every OS.
# This overrides the Git for Windows default (core.autocrlf=true) for this repo.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats (never diff or convert).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
*.xlsx binary
*.xls binary
*.pbf binary
*.pmtiles binary
*.mbtiles binary
*.parquet binary
*.duckdb binary
*.gpkg binary

# Lock files: treat as generated in diffs.
apps/web/package-lock.json linguist-generated=true -diff
pipeline/uv.lock linguist-generated=true -diff
