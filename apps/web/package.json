    "maplibre-gl": "^6.15.0",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
